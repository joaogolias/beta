<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/babel_streak_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/babel_streak_background"
  android:orientation="vertical"
  android:padding="10dp"
  android:importantForAccessibility="yes"
  android:contentDescription="@string/babel_streak_widget_description">
  <TextView
    android:layout_width="match_parent"
    android:layout_height="14dp"
    android:text="@string/babel_streak_widget_heading"
    android:textColor="#D5DAE0"
    android:textSize="9sp"
    android:textStyle="bold"
    android:letterSpacing="0.04"
    android:maxLines="1"
    android:ellipsize="end"
    android:includeFontPadding="false"
    android:importantForAccessibility="no" />
  <ImageView
    android:id="@+id/babel_streak_mascot"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="2dp"
    android:contentDescription="@null"
    android:importantForAccessibility="no"
    android:scaleType="fitCenter"
    android:src="@drawable/babel_streak_ibex" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="38dp"
    android:layout_marginTop="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/babel_streak_count"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:text="0"
      android:textColor="#F4F6F8"
      android:textSize="34sp"
      android:textStyle="bold"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:autoSizeTextType="uniform"
      android:autoSizeMinTextSize="16sp"
      android:autoSizeMaxTextSize="34sp"
      android:autoSizeStepGranularity="1sp"
      android:importantForAccessibility="no" />
    <TextView
      android:id="@+id/babel_streak_days"
      android:layout_width="72dp"
      android:layout_height="match_parent"
      android:layout_marginStart="6dp"
      android:gravity="center_vertical"
      android:text="dias seguidos"
      android:textColor="#F4F6F8"
      android:textSize="11sp"
      android:maxLines="2"
      android:includeFontPadding="false"
      android:importantForAccessibility="no" />
  </LinearLayout>
  <TextView
    android:id="@+id/babel_streak_status"
    android:layout_width="match_parent"
    android:layout_height="28dp"
    android:layout_marginTop="2dp"
    android:gravity="center_vertical"
    android:text="@string/babel_streak_widget_start"
    android:textColor="#D5DAE0"
    android:textSize="11sp"
    android:includeFontPadding="false"
    android:maxLines="2"
    android:ellipsize="end"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="9sp"
    android:autoSizeMaxTextSize="11sp"
    android:importantForAccessibility="no" />
</LinearLayout>
