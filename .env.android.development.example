# Copy to .env.android.development.local. This file is never used for production.
# The legacy .env.android.local is accepted only for development when the
# dedicated development file does not exist.
APP_ENV=development
APP_VERSION=0.1.0
ANDROID_VERSION_CODE=1
EXPO_PUBLIC_CONVEX_URL=https://your-development-deployment.convex.cloud
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Keep the real keystore and its backup outside the repository.
ANDROID_KEYSTORE_PATH=/absolute/private/path/development.p12
ANDROID_KEYSTORE_PASSWORD=REPLACE_ME
ANDROID_KEY_ALIAS=beta-development
ANDROID_KEY_PASSWORD=REPLACE_ME

# Linux/WSL paths for the SDK and Java 17. JAVA_HOME is optional if PATH uses 17.
ANDROID_HOME=/absolute/path/android-sdk
JAVA_HOME=/absolute/path/java-17
