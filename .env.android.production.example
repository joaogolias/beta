# Copy to .env.android.production.local, then replace every placeholder.
# Select explicitly: npm run android:apk -- --environment production
# Production never reads .env.android.local or the development file.
# CI may supply all variables directly without a local file.
APP_ENV=production
APP_VERSION=0.1.0
ANDROID_VERSION_CODE=1
EXPO_PUBLIC_CONVEX_URL=https://glad-bison-698.convex.cloud
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuYmV0YS5nb2xpYXMuZGV2JA

# Use the production signing identity. Keep the keystore and backup outside Git.
# Do not replace an existing production key when preparing an update.
ANDROID_KEYSTORE_PATH=/absolute/private/path/production.p12
ANDROID_KEYSTORE_PASSWORD=REPLACE_ME
ANDROID_KEY_ALIAS=beta-production
ANDROID_KEY_PASSWORD=REPLACE_ME

# Linux/WSL paths for the SDK and Java 17. JAVA_HOME is optional if PATH uses 17.
ANDROID_HOME=/absolute/path/android-sdk
JAVA_HOME=/absolute/path/java-17
