# Production configuration inventory; placeholders do not provision resources.
# Keep backend/.env.local connected to development. The production deployment
# uses its own Convex dashboard variables and a production-scoped deploy key.
# This file is not loaded automatically by the backend or the APK build.

# CI secret: configure only in the GitHub Environment production.
CONVEX_DEPLOY_KEY=REPLACE_WITH_PRODUCTION_DEPLOY_KEY

# Public identity: copy the actual production deployment values from Convex.
# CONVEX_URL is the mobile EXPO_PUBLIC_CONVEX_URL. Do not copy development URLs.
CONVEX_DEPLOYMENT=prod:glad-bison-698
CONVEX_URL=https://glad-bison-698.convex.cloud
CONVEX_SITE_URL=https://glad-bison-698.convex.site

# Set these on the production Convex deployment, not merely in a local file.
# Use the production Clerk issuer and its matching live keys.
# Instance, DNS and TLS are configured; keep live keys in production only.
CLERK_JWT_ISSUER_DOMAIN=https://clerk.beta.golias.dev
CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuYmV0YS5nb2xpYXMuZGV2JA
CLERK_SECRET_KEY=sk_live_REPLACE_ME
MCP_RESOURCE_URL=https://glad-bison-698.convex.site/mcp
MCP_ALLOWED_OAUTH_CLIENT_IDS=lwRmQRQ7spzNW8tB,wXS5CdkfK1TNBuEU
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
LIBRARY_CARD_ORDER_ENABLED=true
LIBRARY_READING_ORDER_ENABLED=true

# CONVEX_CLOUD_URL and CONVEX_SITE_URL are supplied to functions by Convex.
# Never expose CLERK_SECRET_KEY or CONVEX_DEPLOY_KEY through EXPO_PUBLIC_*.
# DEV operator seed scripts are not part of production setup.
