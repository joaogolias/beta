# Copy to backend/.env.local after connecting this directory to Babel Crux.
# The Convex CLI writes the deployment name when the project is configured.
CONVEX_DEPLOYMENT=dev:your-babel-crux-deployment

# Also set this on the matching Convex deployment (not only in this file):
# npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
# Production uses its own Clerk issuer and npx convex env set --prod.
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Remote MCP: configure these in the Convex dashboard, not in the mobile app.
# See docs/mcp.md for Clerk OAuth settings and the ChatGPT callback.
# MCP_RESOURCE_URL=https://your-deployment.convex.site/mcp
# CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# CLERK_SECRET_KEY=sk_test_REPLACE_ME
# MCP_ALLOWED_OAUTH_CLIENT_IDS=your-dedicated-oauth-client-id
